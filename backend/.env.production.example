# Production Environment Configuration
# 
# This file documents environment variables for production deployment

# ===== NEWS POPULATION SETTINGS =====

# Disable automatic news population on startup (optional)
# Set to true if you want to run news population manually only
# DISABLE_STARTUP_NEWS_POPULATION=true

# ===== REQUIRED SETTINGS =====

# Database connection
DATABASE_URL=your_database_url_here

# News API key (required for news fetching)
NEWS_API_KEY=your_news_api_key_here

# JWT secret for authentication
JWT_SECRET=your_jwt_secret_here

# ===== OPTIONAL SETTINGS =====

# Server port (default: 3000)
PORT=10000

# Node environment
NODE_ENV=production

# ===== MANUAL NEWS POPULATION =====
# 
# Run news fetching manually anytime:
# npm run populate:news
# 
# This gives you control over when news is updated without affecting server startup
