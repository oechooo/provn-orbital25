{
  "name": "provn-orbital25-backend",
  "version": "1.0.0",
  "description": "Backend for Provn Orbital25 project",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "dev:ts": "ts-node src/index.ts",
    "build": "tsc",
    "test": "jest",
    "setup:prod": "node scripts/setupProduction.js",
    "startup": "node scripts/startupScript.js",
    "populate:news": "ts-node scripts/fetchAndPopulateNews.ts",
    "clear:news": "node scripts/clearAndRefreshNews.js"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.5",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.7.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/jest": "^29.5.0",
    "@types/supertest": "^2.0.12",
    "jest": "^29.5.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1"
  }
}
